# Copy to .env and edit. Every value here is optional — the defaults run
# out of the box at Times Square.

# --- Station ----------------------------------------------------------------
# One of: times-square, grand-central, union-square, atlantic-av
STATION=times-square

# Or point at any station yourself. Find your stop ID with:
#   python tools/find_stops.py --search "your station name"
# STOP_ID=R16
# ROUTE_IDS=N,Q,R,W
# STOP_NAME=Times Sq 42 St

# --- Weather ----------------------------------------------------------------
# Defaults to the chosen station's coordinates. The NOAA forecast grid is
# resolved from these automatically. US locations only (weather.gov).
# LATITUDE=40.7557
# LONGITUDE=-73.9866

# --- Display ----------------------------------------------------------------
# 'test' renders frames to PNG files instead of driving hardware — use this to
# develop on a laptop without a matrix attached.
# MATRIX_LIBRARY=test

# Raise to 3 or 4 if the panel flickers.
# GPIO_SLOWDOWN=2

# TIMEZONE=America/New_York
# FRAME_DURATION=10
# INFO_PANEL_DURATION=10

# --- API --------------------------------------------------------------------
# The MTA GTFS-realtime feeds are currently open and need no key. Set one here
# if that changes: https://api.mta.info/
# MTA_API_KEY=

# --- Advanced ---------------------------------------------------------------
# LOG_LEVEL=INFO
# Leave TLS verification on. See docs/TROUBLESHOOTING.md before changing it.
# VERIFY_TLS=true
